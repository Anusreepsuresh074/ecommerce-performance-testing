          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="Record cf-cache-status" enabled="true">
            
            
            <stringProp name="RegexExtractor.useHeaders">true</stringProp>
            
            
            <stringProp name="RegexExtractor.refname">cacheStatus</stringProp>
            
            
            <stringProp name="RegexExtractor.regex">(?i)cf-cache-status:\s*(\S+)</stringProp>
            
            
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            
            
            <stringProp name="RegexExtractor.default">NONE</stringProp>
            
            
            <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
            
            
            <stringProp name="RegexExtractor.match_number">1</stringProp>
            
          
          </RegexExtractor>
          
          
          <hashTree/>
          
          
          <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="Record x-ratelimit-remaining" enabled="true">
            
            
            <stringProp name="RegexExtractor.useHeaders">true</stringProp>
            
            
            <stringProp name="RegexExtractor.refname">rateLimitRemaining</stringProp>
            
            
            <stringProp name="RegexExtractor.regex">(?i)x-ratelimit-remaining:\s*(\d+)</stringProp>
            
            
            <stringProp name="RegexExtractor.template">$1$</stringProp>
            
            
            <stringProp name="RegexExtractor.default">NONE</stringProp>
            
            
            <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
            
            
            <stringProp name="RegexExtractor.match_number">1</stringProp>
            
          
          </RegexExtractor>
          
          
          <hashTree/>
          
          
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Stop test on 429" enabled="true">
            
            
            <stringProp name="scriptLanguage">groovy</stringProp>
            
            
            <stringProp name="parameters"/>
            
            
            <stringProp name="filename"/>
            
            
            <stringProp name="cacheKey">true</stringProp>
            
            
            <stringProp name="script">// Plan NFR-07 / 12.3: a 429 means our load is too heavy. Stop the whole test at once; the run is invalid.
if (prev.getResponseCode() == '429') {
    log.error('Rate limit response (429) on ' + prev.getSampleLabel() + ' - stopping the test. This run is INVALID.')
    prev.setStopTestNow(true)
}</stringProp>
            
          
          </JSR223PostProcessor>
          
          
