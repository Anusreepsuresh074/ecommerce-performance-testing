      <hashTree>
        
        
        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="Pacing" enabled="true">
          
          
          <stringProp name="TestPlan.comments">Does nothing itself; its timer waits until this user's next iteration slot. Produces no sample.</stringProp>
          
          
          <intProp name="ActionProcessor.action">1</intProp>
          
          
          <intProp name="ActionProcessor.target">0</intProp>
          
          
          <stringProp name="ActionProcessor.duration">0</stringProp>
          
        
        </TestAction>
        
        
        <hashTree>
          
          
          <JSR223Timer guiclass="TestBeanGUI" testclass="JSR223Timer" testname="Pacing timer" enabled="true">
            
            
            <stringProp name="scriptLanguage">groovy</stringProp>
            
            
            <stringProp name="parameters"/>
            
            
            <stringProp name="filename"/>
            
            
            <stringProp name="cacheKey">true</stringProp>
            
            
            <stringProp name="script">// Plan 6.2: each virtual user starts an iteration every pacing.ms, whatever the response times.
long pacing = Long.parseLong(props.getProperty('pacing.ms', '24000'))
long now = System.currentTimeMillis()
Object last = vars.getObject('iterationStart')
long wait = (last == null) ? 0L : Math.max(0L, ((Long) last) + pacing - now)
vars.putObject('iterationStart', now + wait)
return wait</stringProp>
            
          
          </JSR223Timer>
          
          
          <hashTree/>
          
        
        </hashTree>
        
        
        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="Journey T01-T05" enabled="true">
          
          
          <stringProp name="TestPlan.comments">Everything here applies to each of the 5 transactions.</stringProp>
          
        
        </GenericController>
        
        
        <hashTree>
          
          
          <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="Safety ceiling (5 req/s shared)" enabled="true">
            
            
            <stringProp name="TestPlan.comments">Plan section 13: hard ceiling for all threads together. Pacing normally keeps the load far below it.</stringProp>
            
            
            <intProp name="calcMode">3</intProp>
            
            
            <stringProp name="throughput">${__P(safety.max.samples.per.min,300)}</stringProp>
            
          
          </ConstantThroughputTimer>
          
          
